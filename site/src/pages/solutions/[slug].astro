    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #3FCDA0;
  }
  .next-name-v2 {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 18px;
    font-weight: 600;
    color: #F2F2F0;
  }
  .hero-image-v2 {
    max-width: 1100px;
    margin: -32px auto 0;
    padding: 0 24px 48px;

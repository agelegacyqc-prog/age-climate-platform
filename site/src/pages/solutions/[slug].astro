---
import Layout from '../../layouts/Layout.astro';
import { solutions } from '../../data/solutions';

export function getStaticPaths() {
  return Object.keys(solutions).map((slug) => ({
    params: { slug },
  }));
}

const { slug } = Astro.params;
const s = solutions[slug];

const familySlugs = Object.keys(solutions).filter((key) => key !== 'dematerialisation-decarbonation');
const currentIndex = familySlugs.indexOf(slug);
const nextSlug = currentIndex === -1 ? null : familySlugs[(currentIndex + 1) % familySlugs.length];
const nextSolution = nextSlug ? solutions[nextSlug] : null;
---

<Layout title={`${s.nom} — AGE-QC`} description={s.intro}>
  {s.nouveauDesign ? (
    <>
      <section class="hero-v2">
        <div class="badge-v2">{s.numero}</div>
        {s.badgePartenaire && <p class="partner-badge-v2">{s.badgePartenaire}</p>}
        {s.etape && <p class="eyebrow-v2">{s.etape}</p>}
        <h1>{s.nom}</h1>
        <p class="tagline-v2">{s.tagline}</p>
        <p class="intro-v2">{s.intro}</p>
        {s.citation && <blockquote class="citation-v2">{s.citation}</blockquote>}
        {nextSolution && (
          <a href={`/solutions/${nextSolution.slug}`} class="next-link-v2">
            <span class="next-label-v2">Solution suivante</span>
            <span class="next-name-v2">{nextSolution.nom} →</span>
          </a>
        )}
      </section>
      {!s.sansImageHero && (
        <section class="hero-image-v2">
          <img src={`/images/solutions/${s.slug}-1.jpg`} alt={s.nom} loading="lazy" />
        </section>
      )}
    </>
  ) : (
    <section class="hero">
      <div class="badge">{s.numero}</div>
      <p class="eyebrow">{s.etape}</p>
      {s.badgePartenaire && <p class="partner-badge">{s.badgePartenaire}</p>}
      <h1>{s.nom}</h1>
      <p class="tagline">{s.tagline}</p>
    <p class="intro">{s.intro}</p>
      {s.citation && <blockquote class="citation">{s.citation}</blockquote>}
      {nextSolution && (
        <a href={`/solutions/${nextSolution.slug}`} class="next-link">
          <span class="next-label">Solution suivante</span>
          <span class="next-name">{nextSolution.nom} →</span>
        </a>
      )}
    </section>
  )}

  {s.constat && (
    <section class="constat">
      <div class="constat-grid">
        {s.constat.map((item) => (
          <div class="constat-card">
            <h3>{item.titre}</h3>
            <p>{item.description}</p>
          </div>
        ))}
      </div>
    </section>
  )}

  {s.methode && (
    <section class="methode">
      <h2>Notre méthode</h2>
      <div class="methode-line-wrap">
        <div class="methode-line"></div>
        <div class="methode-grid">
          {s.methode.map((etape, i) => (
            <div class="methode-step">
              <div class={`step-icon ${i === s.methode.length - 1 ? 'step-icon-last' : ''}`}>
                {etape.icone === 'audit' && (
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="10" cy="10" r="6"/><path d="M20 20l-4.35-4.35"/></svg>
                )}
                {etape.icone === 'scan' && (
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 8V5a1 1 0 0 1 1-1h3M20 8V5a1 1 0 0 0-1-1h-3M4 16v3a1 1 0 0 0 1 1h3M20 16v3a1 1 0 0 1-1 1h-3M4 12h16"/></svg>
                )}
                {etape.icone === 'dedoublonnage' && (
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="7" y="7" width="11" height="11" rx="2"/><path d="M4 14V5a2 2 0 0 1 2-2h9"/></svg>
                )}
                {etape.icone === 'archive' && (
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="5" rx="1"/><path d="M5 9v9a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V9M10 13h4"/></svg>
                )}
                {etape.icone === 'recyclage' && (
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M7 19H4.815a1.83 1.83 0 0 1-1.57-.881 1.785 1.785 0 0 1-.004-1.784L4.5 12M6.5 6.5 9 2l2.5 4.5M17 19h2.185a1.83 1.83 0 0 0 1.57-.881 1.785 1.785 0 0 0 .004-1.784L19.5 12M9 22l2.5-4.5L14 22"/></svg>
                )}
                {etape.icone === 'reporting' && (
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M7 15l3-3 2 2 4-4"/></svg>
                )}
              </div>
              <div class={`step-card ${i === s.methode.length - 1 ? 'step-card-last' : ''}`}>
                <div class="step-num">{etape.numero}</div>
                <h4>{etape.titre}</h4>
                <p class="step-desc">{etape.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
      {s.methodePrincipe && <p class="methode-principe">{s.methodePrincipe}</p>}
      {s.livrable && <p class="livrable"><strong>Ce que vous recevez :</strong> {s.livrable}</p>}
    </section>
  )}

  {s.methodologie && (
    <section class="methodologie">
      <h2>La preuve, pas la promesse</h2>
      <div class="methodologie-grid">
        {s.methodologie.map((item) => (
          <div>
            <h3>{item.titre}</h3>
            <p>{item.description}</p>
          </div>
        ))}
      </div>
    </section>
  )}

  {s.casUsage && (
    <section class="cas-usage">
      <h2>Cas d'usage par secteur</h2>
      <div class="cas-usage-grid">
        {s.casUsage.map((item) => (
          <div class="cas-usage-card">
            <h3>{item.secteur}</h3>
            <p>{item.description}</p>
          </div>
        ))}
      </div>
    </section>
  )}

  {s.nouveauDesign && s.sections.length > 0 ? (
    <section class="sections-v2">
      <div class="sections-v2-grid">
        {s.sections.map((block) => (
          <div class="section-card-v2">
            <h3>{block.titre}</h3>
            <p>{block.description}</p>
            <ul>
              {block.checklist.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </section>
  ) : (
    s.sections.map((block, i) => (
      <section class={`block ${i % 2 === 1 ? 'reverse' : ''}`}>
        <div class="block-text">
          <h2>{block.titre}</h2>
          <p>{block.description}</p>
          <ul>
            {block.checklist.map((item) => <li>{item}</li>)}
          </ul>
        </div>
       <div class="block-visual">
          <img
            src={`/images/solutions/${s.slug}-${i + 1}.jpg`}
            alt={block.titre}
            loading="lazy"
          />
        </div>
      </section>
    ))
  )}

  <section class="closing">
    <p>{s.closing}</p>
  </section>

 <section class="cta">
    <h2>Prêt à passer à l'action ?</h2>
    <a href="/contact" class="btn-primary">Demander une démo</a>
  </section>
</Layout>

<style>
  .hero {

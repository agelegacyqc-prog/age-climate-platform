    border-radius: 50%;
    background: #3FCDA0;
    color: #111111;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 24px;
    font-family: 'JetBrains Mono', monospace;
    font-weight: 700;
    font-size: 18px;
  }
  .eyebrow {
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #3FCDA0;
    margin-bottom: 12px;
  }
  h1 {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 42px;
    font-weight: 600;
    margin-bottom: 12px;
  }
  .tagline {
    font-family: 'Inter', sans-serif;
    font-weight: 500;
    font-size: 18px;
    color: #3FCDA0;
    margin-bottom: 20px;
  }
  .intro {
    font-family: 'Inter', sans-serif;
    font-size: 16px;
    color: rgba(255,255,255,0.75);
    max-width: 620px;
    margin: 0 auto;
    line-height: 1.6;
  }
  .partner-badge {
    display: inline-block;
    background: #F2F2F0;
    color: #111111;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    padding: 4px 12px;
    border-radius: 20px;
    margin-bottom: 16px;
  }
  .citation {
    max-width: 620px;
    margin: 28px auto 0;
    padding: 12px 20px;
    border-left: 3px solid #3FCDA0;
    text-align: left;
    font-style: italic;
    font-size: 14px;
    color: rgba(255,255,255,0.85);
    background: rgba(255,255,255,0.04);
  }

  .hero-v2 {
    background: linear-gradient(180deg, #111111 0%, #183328 100%);
    color: #F2F2F0;
    padding: 96px 24px 56px;
    text-align: center;
  }
  .badge-v2 {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: #3FCDA0;
    color: #111111;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 20px;
    font-family: 'JetBrains Mono', monospace;
    font-weight: 700;
    font-size: 18px;
  }
  .partner-badge-v2 {
    display: inline-block;
    background: #F2F2F0;
    color: #111111;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    padding: 4px 12px;
    border-radius: 20px;
    margin-bottom: 16px;
  }
  .eyebrow-v2 {
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;

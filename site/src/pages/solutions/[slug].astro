    padding: 64px 24px;
    max-width: 1100px;
    margin: 0 auto;
  }
  .block.reverse {
    direction: rtl;
  }
  .block.reverse > * {
    direction: ltr;
  }
  .block-text h2 {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 26px;
    font-weight: 600;
    margin-bottom: 14px;
  }
  .block-text p {
    font-family: 'Inter', sans-serif;
    font-size: 15px;
    color: rgba(255,255,255,0.75);
    line-height: 1.6;
    margin-bottom: 20px;
  }
  .block-text ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .block-text li {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    color: #fff;
    padding-left: 26px;
    position: relative;
  }
  .block-text li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: #3FCDA0;
    font-weight: 700;
  }
  .block-visual {
    border-radius: 20px;
    overflow: hidden;
    min-height: 260px;
  }
  .block-visual img {
    width: 100%;
    height: 100%;
    min-height: 260px;
    object-fit: cover;
    display: block;
  }

  .constat, .methodologie, .cas-usage {
    max-width: 1100px;
    margin: 0 auto;
    padding: 64px 24px;
  }
  .constat h2, .methode h2, .methodologie h2, .cas-usage h2 {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 26px;
    font-weight: 600;
    color: #111111;
    margin-bottom: 28px;
    text-align: center;
  }
  .constat-grid, .methodologie-grid, .cas-usage-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }
  .constat-card, .cas-usage-card {
    background: #F2F2F0;
    border-radius: 12px;
    padding: 20px 24px;
  }
  .constat-card h3, .cas-usage-card h3 {
    font-family: 'Inter', sans-serif;
    font-weight: 500;
    font-size: 15px;
    color: #3F7A5D;
    margin-bottom: 8px;
  }
  .constat-card p, .cas-usage-card p, .methodologie-grid p {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    color: #444;
    line-height: 1.6;
  }
  .methodologie-grid h3 {
    font-family: 'Inter', sans-serif;
    font-weight: 500;
    font-size: 15px;
    color: #111111;
    margin-bottom: 8px;
  }

  .methode {
    background: linear-gradient(180deg, #111111 0%, #183328 100%);
    border-radius: 24px;
    max-width: 1100px;
    margin: 0 auto;
    padding: 40px 24px 32px;
  }
  .methode h2 {
    color: #F2F2F0;
  }
  .methode-line-wrap {
    position: relative;
    padding: 0 8px;
  }
  .methode-line {
    position: absolute;
    top: 26px;
    left: 5%;
    right: 5%;
    height: 2px;
    background: #3FCDA0;
    opacity: 0.5;
  }
  .methode-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 10px;
    position: relative;
  }
  .methode-step {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .step-icon {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: #3FCDA0;
    color: #0a2e21;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1;
    margin-bottom: 14px;
  }
  .step-icon-last {
    background: #F2F2F0;
    color: #111111;
  }
  .step-card {
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 12px;
    padding: 14px 10px;
    width: 100%;
    min-height: 120px;
  }
  .step-card-last {
    background: rgba(255,255,255,0.1);
    border: 1px solid #3FCDA0;
  }
  .step-num {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    color: #3FCDA0;
    margin-bottom: 4px;
  }
  .step-card h4 {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 600;
    font-size: 13px;
    color: #F2F2F0;
    margin-bottom: 6px;
  }
  .step-desc {
    font-size: 10.5px;
    color: rgba(242,242,240,0.65);
    line-height: 1.4;

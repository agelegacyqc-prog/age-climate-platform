  .closing {
    background: linear-gradient(180deg, #111111 0%, #183328 100%);
    color: #fff;
    text-align: center;
    padding: 72px 24px;
  }
  .closing p {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 24px;
    font-weight: 600;
    max-width: 680px;
    margin: 0 auto;
    line-height: 1.4;
  }


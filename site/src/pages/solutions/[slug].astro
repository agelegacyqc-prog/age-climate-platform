    font-weight: 500;
    font-size: 15px;
    padding: 12px 28px;
    border-radius: 8px;
    text-decoration: none;
  }

  @media (max-width: 768px) {
    .block, .block.reverse { direction: ltr; grid-template-columns: 1fr; }
    .constat-grid, .methodologie-grid, .cas-usage-grid { grid-template-columns: 1fr; }
    .methode-grid { grid-template-columns: repeat(2, 1fr); }
    .methode-line { display: none; }
    .sections-v2-grid { grid-template-columns: 1fr; }
  }
</style>